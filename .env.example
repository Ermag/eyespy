# Shared secret for the apps and API. Generate: openssl rand -hex 24
EYESPY_TOKEN=change-me-change-me-change-me

# Your timezone (used for day folders / grouping)
TZ=UTC

# Host port for the API/dashboard, and the host user that owns ./data (see `id`)
EYESPY_PORT=8080
EYESPY_UID=1000
EYESPY_GID=1000

# Push notifications via ntfy (https://ntfy.sh). Pick a long random topic name - anyone who
# knows it can read your notifications. Generate: echo eyespy-$(openssl rand -hex 12)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Presence relay topic (phone -> server). Defaults to "<NTFY_TOPIC>-presence".
#NTFY_PRESENCE_TOPIC=
# Only for a self-hosted/protected ntfy server
#NTFY_TOKEN=
# Attach the motion snapshot image to the push (image is uploaded to the ntfy server)
NTFY_ATTACH_SNAPSHOT=false
MOTION_PUSH_COOLDOWN_S=120
CAMERA_OFFLINE_ALERT_S=120

# Retention
# footage without motion
RETENTION_DAYS=3
# footage with motion, events and snapshots
MOTION_RETENTION_DAYS=14
# 0 = no cap; oldest non-motion footage goes first
MAX_STORAGE_GB=0
MIN_FREE_GB=2
